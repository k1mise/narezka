# Скопируй этот файл в .env (рядом с run.py) и заполни. Файл .env никому не показывай.

# YouTube: общие ключи Google OAuth-приложения (или у каждого аккаунта свои — кнопка «Ключи», или файл assets/client_secret.json)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Instagram (Meta): developers.facebook.com → приложение → Настройки → Основное
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok: developers.tiktok.com → приложение → Client key / Client secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Telegram Mini App (Этап 3, пока не нужно)
TELEGRAM_BOT_TOKEN=
MAIN_ADMIN_IDS=
